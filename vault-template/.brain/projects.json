{
  "_note": "rules: map file paths to a project (note name); first matching rule wins; project \"\" = deliberately ignore. scan: where `brain.py docs` looks for documents. Use forward slashes or ~ on every OS.",
  "owner": "My",
  "rules": [
    {
      "match": "(?i)passw|1password|recovery|bank.?statement",
      "regex": true,
      "project": ""
    },
    {
      "match": "~/Desktop/Example project",
      "project": "Example project"
    },
    {
      "match": "/(Example_|example-)[^/\\\\]*$",
      "regex": true,
      "project": "Example project"
    }
  ],
  "scan": {
    "roots": [
      "~/Desktop",
      "~/Downloads",
      "~/Documents"
    ],
    "max_depth": 4,
    "extensions": [
      "docx",
      "doc",
      "pdf",
      "xlsx",
      "xls",
      "pptx",
      "key",
      "pages",
      "numbers",
      "odt",
      "html",
      "txt",
      "md",
      "mp4",
      "m4a",
      "wav",
      "mp3",
      "ics",
      "csv"
    ],
    "skip_dirs": [
      "node_modules",
      ".git",
      ".next",
      "Library",
      "AppData"
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "py -3 VAULT/scripts/brain.py context", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "py -3 VAULT/scripts/brain.py hook", "timeout": 10 }
        ]
      }
    ]
  }
}
